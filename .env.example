# Copy to .env and adjust. Local Docker Postgres:
DATABASE_URL=postgres://tessera:tessera@localhost:5432/tessera
# Supabase (Connect > Session pooler), add ?sslmode=require:
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
# Tessera's tables live in this schema, so it can share a database with other apps.
DB_SCHEMA=tessera
API_PORT=4000
# Required in production: a long random string for signing sign-in tokens.
# AUTH_SECRET=
